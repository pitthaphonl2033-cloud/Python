# 2
title=input("Enter your title")
score=int(input("Enter your score"))
maxscore=int(input("Enter your maximum score"))
percentage2=(score/maxscore)*100
average=(percentage+percentage2)/2
       

print(title)
print("Score:",score)
print("Maximum score:",maxscore)
print("Percentage:",percentage2,"%")

    
print("Average",average)
grade=int(average)
if grade>=95:
    print("Your grade is: A+")
elif grade>=90:
    print("Your grade is A")
elif grade>=85:
    print("Your grade is B+")
elif grade>=80:
    print("Your grade is B")
elif grade>=75:
    print("Your grade is C+")
elif grade>=70:
    print("Your grade is C")
elif grade>=65:
    print("Your grade is D+")
elif grade>=60:
    print("Your grade is D")
elif grade<60:
    print("Your grade is F")
else:
    print("Your grade is F")


